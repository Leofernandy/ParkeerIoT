<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="30dp"
        android:paddingHorizontal="36dp">

        <ImageView
            android:id="@+id/imvLogo"
            android:layout_width="72dp"
            android:layout_height="86dp"
            app:srcCompat="@drawable/logo" />

        <TextView
            android:id="@+id/txvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textSize="22sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:text="Welcome to Parkeer!" />

        <TextView
            android:id="@+id/txvSlogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#666666"
            android:textSize="13sp"
            android:text="Save Time, Park Faster" />

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="20dp"
            android:background="@drawable/rounded_edt"
            android:textSize="13sp"
            android:inputType="textEmailAddress"
            android:hint="Email Address" />

        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingHorizontal="20dp"
            android:background="@drawable/rounded_edt"
            android:textSize="13sp"
            android:inputType="textPassword"
            android:layout_marginTop="16dp"
            android:hint="Password" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbxKeepMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/navy"
                android:buttonTint="@color/navy"
                android:textSize="12sp"
                android:text="Keep me logged in" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txvForgotPass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/navy"
                android:text="Forgot Password?" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/rounded_edt"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:text="LOGIN" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txvDontHaveAcc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/greytua"
                android:textSize="13sp"
                android:text="Don't have an account?" />

            <TextView
                android:id="@+id/txvLinkSignUp"
                android:layout_width="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:textColor="@color/navy"
                android:text=" Sign Up" />

        </LinearLayout>

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:gravity="center"
            android:textColor="@color/greytua"
            android:text="─────────── or continue with ───────────" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/rounded_edt">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/google" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/rounded_edt">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/fb" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/rounded_edt">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/apple" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/rounded_edt">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/twitter" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>