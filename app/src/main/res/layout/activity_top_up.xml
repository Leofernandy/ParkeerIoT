<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Top Up Wallet"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Amount (IDR)"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edtAmount"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Min. 10.000"
        android:inputType="number"
        android:paddingLeft="15dp"
        android:background="@drawable/bg_slot_available" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:layout_marginTop="20dp">

        <Button android:id="@+id/btn10k" android:text="10.000" android:layout_columnWeight="1" style="?android:attr/buttonBarButtonStyle"/>
        <Button android:id="@+id/btn20k" android:text="20.000" android:layout_columnWeight="1" style="?android:attr/buttonBarButtonStyle"/>
        <Button android:id="@+id/btn50k" android:text="50.000" android:layout_columnWeight="1" style="?android:attr/buttonBarButtonStyle"/>
    </GridLayout>

    <Button
        android:id="@+id/btnContinueTopUp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:backgroundTint="@color/navy"
        android:text="CONTINUE TO PAYMENT"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>